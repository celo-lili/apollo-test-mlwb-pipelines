# Template — copy to .env and fill in real values. .env is gitignored, never committed.
# These credentials authenticate the S3 ingestion push to the Celonis data pool.
aws_access_key_id=YOUR_KEY
aws_secret_access_key=YOUR_SECRET

# CELONIS_URL is pre-set inside MLWB — only needed for LOCAL testing of the push.
# CELONIS_URL=your-team.your-env.celonis.cloud
